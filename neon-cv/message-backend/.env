PORT=4000

# Option A — SMTP (Nodemailer) - example using Gmail/other SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bookingskevinmars@gmail.com
SMTP_PASS=app_password_here

# Option B — SendGrid (API)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxx
# SENDGRID_FROM=you@yourdomain.com

# If you want to store messages in MongoDB (optional)
MONGO_URI=mongodb+srv://user:pass@cluster0.mongodb.net/messages?retryWrites=true&w=majority

# Where to send message notifications
NOTIFY_TO=bookingskevinmars@gmail.com
NOTIFY_FROM=your.email@domain.com
